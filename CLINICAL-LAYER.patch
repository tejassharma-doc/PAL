+        if not entries:
+            return ""
+
+        # Newest last: the model reads the thread in the order it happened.
+        thread = "\n\n".join(entries)
+        if len(thread) > self.SUMMARY_CHAR_BUDGET:
+            thread = "…\n\n" + thread[-self.SUMMARY_CHAR_BUDGET:]
+        return thread
 
     async def purge_thread(self, conversation_id: uuid.UUID) -> None:
         """Called when patient deletes a conversation. Clears the conversation bank."""
