{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@services/*": [
        "src/services/*"
      ],
      "@screens/*": [
        "src/screens/*"
      ],
      "@components/*": [
        "src/components/*"
      ],
      "@navigation/*": [
        "src/navigation/*"
      ]
    },
    "strict": true
  },
  "exclude": [
    "node_modules",
    "src/screens/legacy/**",
    "android",
    "ios",
    "__tests__/integration/**"
  ]
}