<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Android 15 (API 35) enforces edge-to-edge for apps targeting SDK 35, which
        stops adjustResize from shrinking the window for the keyboard and draws
        content under the system bars. Opt out until the UI handles insets fully.
    -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/white</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
