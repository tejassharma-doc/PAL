<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Config — allows cleartext HTTP to localhost and LAN IPs
    used by Metro bundler and the PAL dev backend.
    For production (release builds) this section should be removed or restricted.
-->
<network-security-config>
    <!-- Allow cleartext to the Android emulator host (maps to dev machine localhost) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- LAN IP range used when testing on a physical device -->
        <domain includeSubdomains="false">192.168.0.0</domain>
    </domain-config>
    <!-- All other traffic must use HTTPS -->
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
