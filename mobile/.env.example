# PAL Mobile — configuration lives in src/config.ts (React Native has no .env
# loader configured). Values there:
#
#   PROD_API_BASE      https://palcare.life/api   (release builds)
#   DEV_API_BASE       http://10.0.2.2:8001       (debug builds; emulator → docker-compose API on your PC)
#   USE_PROD_IN_DEBUG  false                      (true = debug build talks to production)
#
# Default test account (seed it on the server with api/scripts/seed_test_account.py):
#   username paltest / email test@palcare.life / password PalTest@2026
# Debug builds pre-fill it on the login screen; release builds do not contain it.
