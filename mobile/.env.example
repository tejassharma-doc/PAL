# PAL Mobile — environment variables
# Copy to .env and fill in values before running.

# API base URL (no trailing slash)
PAL_API_URL=http://localhost:8000

# Feature flags
UNIVERSAL_SEARCH=true

# Auth
PAL_JWT_SECRET=changeme

# Fugu Router model (ONNX, bundled with the app)
FUGU_MODEL_PATH=assets/models/multilingual-e5-small.onnx
