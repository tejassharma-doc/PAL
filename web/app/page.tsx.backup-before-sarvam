                          <div key={msg.id} style={{ display: 'flex', justifyContent: 'flex-start' }}>
                            <div style={{ border: '1px solid rgba(194,103,94,.4)', background: 'rgba(194,103,94,.06)', borderRadius: '4px 14px 14px 14px', padding: '12px 14px', maxWidth: '92%' }}>
