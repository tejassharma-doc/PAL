                    <circle cx="12" cy="9" r="2.5"/>
                    <path d="M8 17a4 4 0 0 1 8 0"/>
                    <path d="M3.5 12A8.5 8.5 0 0 1 12 3.5"/>
                    <path d="M20.5 12A8.5 8.5 0 0 1 12 20.5"/>
