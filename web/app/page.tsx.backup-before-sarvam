                    <span>
                      <span style={{ fontSize: '.86rem', fontWeight: 500, lineHeight: 1.3, display: 'block' }}>{g.text}</span>
                      <span style={{ fontFamily: mono, fontSize: '.58rem', opacity: .5 }}>{g.sub}</span>
                    </span>
                  </button>
                ))}

