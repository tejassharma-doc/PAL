# ===================================================================
# PAL Production Environment Configuration
# ===================================================================

# Database
POSTGRES_USER=pal
POSTGRES_PASSWORD=pal_prod_secure_password_change_me
POSTGRES_DB=pal

# Redis
REDIS_URL=redis://redis:6379/0

# MCP API Server (for mobile apps)
PAL_API_KEY=pal-secret-key-production-change-me
MCP_API_URL=http://mcp-api:3001

# LiteLLM Proxy Configuration (for Hermes Chat)
OPENAI_API_BASE=https://pal-agent.medmode.org/litellm/v1
OPENAI_API_KEY=sk-8cxtPKSUF-ENMMTD7pTnKg
GEMINI_MODEL=vertex_ai/google/gemma-4-26b-a4b-it-maas
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2000

# Feature Flags
DEPLOYMENT_MODE=self_hosted
AI_KEY_MODE=byo
MULTI_USER=false
FAMILY_RELATIONSHIPS=false
ADMIN_DASHBOARD=true

# Vectorize.io Hindsight
HINDSIGHT_ENABLED=false
HINDSIGHT_LLM_PROVIDER=openai
HINDSIGHT_LLM_MODEL=vertex_ai/google/gemma-4-26b-a4b-it-maas
HINDSIGHT_LLM_API_KEY=sk-8cxtPKSUF-ENMMTD7pTnKg
HINDSIGHT_API_BASE=http://pal-agent.medmode.org:4000/v1

# On-device models
NEXT_PUBLIC_CLASSIFIER_MODEL=HuggingFaceTB/SmolLM2-360M-Instruct
NEXT_PUBLIC_STT_MODEL=onnx-community/whisper-small
NEXT_PUBLIC_EHR_SUMMARY_MODEL=HuggingFaceTB/SmolLM2-1.7B-Instruct
UNIVERSAL_SEARCH=true

# Semantic cache
SEMANTIC_CACHE_MODEL=all-MiniLM-L6-v2

# Google Health Medical Data Toolkit (MDT)
MDT_ENABLED=true
MDT_URL=http://mdt:8080
GEMINI_API_KEY=AIzaSyDUd-lkQq4A25xWTkuXT8HoIKBZtYi-Uyo
MDT_MODEL=gemini-2.5-flash
upload_dir=./uploads

# AI Provider (BYO mode)
ANTHROPIC_API_KEY=

# Operator AI key (institutional mode only)
OPERATOR_ANTHROPIC_API_KEY=
OPERATOR_AI_PROVIDER=anthropic
OPERATOR_BEDROCK_REGION=ap-south-1

# Security
SECRET_KEY=change_me_to_random_secret_in_production_use_openssl_rand
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# App
APP_NAME=PAL
ENVIRONMENT=production

# Next.js - PRODUCTION URLs
NEXT_PUBLIC_API_URL=https://palcare.life
NEXT_PUBLIC_APP_NAME=PAL

# ===================================================================
# FAMILY CHAT & FAMILY PLAN CONFIGURATION (NEW)
# ===================================================================

# === FEATURE FLAGS ===
# Set to false to completely disable features
CHAT_ENABLED=true
FAMILY_PLAN_ENABLED=true

# === CHAT SETTINGS ===
# Redis for chat pub/sub (blank = reuse main Redis on logical DB 2)
CHAT_REDIS_URL=

# Chat limits
CHAT_MAX_MESSAGE_LENGTH=4000
CHAT_WS_HEARTBEAT=25
CHAT_RATE_LIMIT_PER_MIN=60

# === CENTRIFUGO (Production WebSocket Server) ===
# Transport mode: 'centrifugo' or 'native'
CHAT_TRANSPORT=centrifugo

# Centrifugo URLs
# Browser/mobile-facing WebSocket endpoint
CENTRIFUGO_URL=wss://palcare.life/ws/connection/websocket
# Fallback HTTP: ws://100.108.87.169:8100/connection/websocket

# Server-to-server HTTP API (internal docker network)
CENTRIFUGO_API_URL=http://centrifugo:8000/api

# Centrifugo secrets (GENERATED - DO NOT CHANGE)
CENTRIFUGO_API_KEY=c027c156d1f28172c354be892fa8fccc17dcbff143e940fecd1deb49b9581e1b
CENTRIFUGO_TOKEN_HMAC_SECRET=aca5a052a0faf8cf9adc661896a0cb51461d201b6b4ba06e8dc1ae12421d25bd

# Token TTL (clients auto-refresh)
CENTRIFUGO_TOKEN_TTL=1800  # 30 minutes
CENTRIFUGO_API_TIMEOUT=5.0

# === SCALE OPTIMIZATIONS ===
# Membership cache (keeps is_room_member() off PostgreSQL)
CHAT_MEMBERSHIP_CACHE_ENABLED=true
CHAT_MEMBERSHIP_CACHE_TTL=60
CHAT_MEMBERSHIP_CACHE_DENY_TTL=10

# Identity cache for realtime token endpoints only
CHAT_PRINCIPAL_CACHE_TTL=30

# Per-user jitter on token TTL (prevents reconnect storms)
CENTRIFUGO_TOKEN_TTL_JITTER=0.2

# === OBSERVABILITY ===
# Prometheus metrics endpoint /metrics
# Requires: pip install prometheus-client
METRICS_ENABLED=false

# === FAMILY PLAN SETTINGS ===
# Maximum members per family plan
FAMILY_MAX_MEMBERS=6

# Maximum family plans per user (prevents abuse)
FAMILY_MAX_PLANS_PER_USER=3

# Invite code TTL
FAMILY_INVITE_TTL_MINUTES=10080  # 7 days

# Currency for payment requests
FAMILY_DEFAULT_CURRENCY=INR

# Payment link base URL
# Links generated as: {base}/{payment_request_id}
FAMILY_PAYMENT_LINK_BASE=https://pal-agent.medmode.org/pay

# === DOCEHR INTEGRATION ===
# External DocEHR MCP endpoint
DOCEHR_ENABLED=true
DOCEHR_MCP_URL=https://mcp-doc-ehr.medmode.org  # Keep external MCP server as-is

# === BIORXIV MCP INTEGRATION ===
# Medical research papers (bioRxiv + medRxiv)
BIORXIV_MCP_ENABLED=true
BIORXIV_MCP_URL=http://biorxiv-mcp:3010/mcp
BIORXIV_MAILTO=admin@medmode.org

# === PUBMED MCP INTEGRATION ===
# PubMed medical literature search
PUBMED_MCP_ENABLED=true
PUBMED_MCP_URL=http://pubmed-mcp:3011/mcp
PUBMED_EMAIL=admin@medmode.org
PUBMED_TOOL=PAL
