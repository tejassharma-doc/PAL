# PAL Health — Android environment configuration
# Copy this file to .env and fill in values before building.
# Never commit .env to version control.

# PAL backend API URL
# Development (Android emulator → host machine): use 10.0.2.2
# Development (physical device): use your machine's LAN IP, e.g. http://192.168.1.5:8000
# Production: https://api.palhealth.app
PAL_API_URL=http://10.0.2.2:8000

# Enable the Universal Search feature (requires the search backend to be running)
UNIVERSAL_SEARCH=true

# Gemma 4 API Key — forwarded to the Medical Data Toolkit (MDT) for cloud Gemma inference.
# Leave empty to use local Gemma weights bundled in the MDT Docker container.
# Format: GCP Vertex AI Bearer token
GEMMA_4_API_KEY=
