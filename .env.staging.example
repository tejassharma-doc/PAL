# ─────────────────────────────────────────────────────────────────────────────
# STAGING stack — Compose interpolation file
#
# Copy this to a file literally named `.env` INSIDE the staging checkout:
#     cp .env.staging.example .env
# Docker Compose auto-reads `.env` in the project dir for ${...} substitution in
# docker-compose.prod.yml. This is what makes the staging stack isolated from prod
# (different project name, container names, host ports, DB volume).
#
# TWO env layers — don't confuse them:
#   1. THIS file (.env) → values Compose substitutes into the compose file
#      (STACK, *_PORT, PUBLIC_API_URL, and the ${POSTGRES_PASSWORD}/${PAL_API_KEY}/
#       ${GEMINI_API_KEY} the compose references directly).
#   2. ENV_FILE (.env.staging) → the file injected wholesale INTO the containers
#      (SARVAM_API_KEY, SECRET_KEY, Razorpay keys, etc.). Create it as a staging
#      copy of .env.production with staging-appropriate secrets.
#
# Production needs NONE of this: with no .env overrides the defaults in the compose
# file reproduce the current prod stack exactly.
# ─────────────────────────────────────────────────────────────────────────────

# Isolation: unique project + container-name prefix (→ separate volumes/network/DB)
STACK=pal-staging

# The in-container env file for this stack (make a staging copy of .env.production)
ENV_FILE=.env.staging

# Host ports — every one shifted off prod so the two stacks don't collide
DB_PORT=5434
REDIS_PORT=6381
API_PORT=8011
WEB_PORT=3012
MCP_PORT=3013
FASTMCP_PORT=8012
FLOWER_PORT=5556
MDT_PORT=8091

# Public URL the web build/runtime is told to call (staging domain)
PUBLIC_API_URL=https://staging.palcare.life

# MDT reads the LOINC KB from the host; point at THIS checkout's copy
LOINC_DIR=/data/apps/docmode/PAL-staging/loinc-kb-minimal

# ── Values the compose file references with ${...} (must be present here too) ──
# Use a SEPARATE staging DB password; the staging DB is a fresh, empty volume.
POSTGRES_USER=pal
POSTGRES_PASSWORD=change_me_staging_db_password
POSTGRES_DB=pal
PAL_API_KEY=change_me_staging_pal_api_key
GEMINI_API_KEY=change_me_staging_gemini_key
