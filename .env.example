# Database
POSTGRES_USER=pal
POSTGRES_PASSWORD=change_me_in_prod
POSTGRES_DB=pal

# Redis
REDIS_URL=redis://redis:6379/0

# Feature Flags
DEPLOYMENT_MODE=self_hosted          # self_hosted | institutional
AI_KEY_MODE=byo                      # byo | operator
MULTI_USER=false
FAMILY_RELATIONSHIPS=false
ADMIN_DASHBOARD=false

# Vectorize.io Hindsight — optional enhanced memory (semantic+BM25+graph+temporal recall)
# pip install hindsight-all required in api/requirements.txt
HINDSIGHT_ENABLED=false
HINDSIGHT_LLM_PROVIDER=anthropic    # anthropic | openai | groq
HINDSIGHT_LLM_MODEL=claude-haiku-4-5-20251001
HINDSIGHT_LLM_API_KEY=              # leave blank to reuse ANTHROPIC_API_KEY

# On-device classifier (browser, @huggingface/transformers)
# HuggingFaceTB/SmolLM2-360M-Instruct — ONNX-ready, 360 MB, runs on WebGPU/WASM
# Swap for Gemma 4 when onnx-community/gemma-4-E2B-it-ONNX is published
NEXT_PUBLIC_CLASSIFIER_MODEL=HuggingFaceTB/SmolLM2-360M-Instruct
# Whisper ONNX — speech-to-text, 99 languages incl. all major Indian languages
# Non-English Indian script queries skip SmolLM2 and route directly to Claude
# whisper-small (244 MB) — recommended for Indian language accuracy
# whisper-tiny  (39 MB)  — faster, adequate for English / clear pronunciation
# Swap to a larger model when bandwidth/storage allows
NEXT_PUBLIC_STT_MODEL=onnx-community/whisper-small
UNIVERSAL_SEARCH=false

# AI Provider (BYO mode — user-supplied, never logged)
ANTHROPIC_API_KEY=                   # filled by user in self-hosted mode

# Operator AI key (institutional mode only — write-only, never returned)
OPERATOR_ANTHROPIC_API_KEY=
OPERATOR_AI_PROVIDER=anthropic       # anthropic | bedrock
OPERATOR_BEDROCK_REGION=ap-south-1

# Security
SECRET_KEY=change_me_to_random_secret_in_prod
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# App
APP_NAME=PAL
ENVIRONMENT=development              # development | production

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=PAL

# ---------------------------------------------------------------------------
# PubMed / NCBI E-utilities  (services/clinical/pubmed.py)
#
# ALL OPTIONAL. With this whole block absent, PubMed still works: the defaults
# are a polite client inside NCBI's anonymous rate limit. Uncomment only what
# you want to change.
#
# To see what is actually in force on a running deployment:
#     docker compose exec api python scripts/pubmed_setup.py --check
# It prints every value, where it came from, and then makes one live request.
# It never prints the API key itself — only whether one is set and how long it
# is, so the output is safe to paste into a ticket.
# ---------------------------------------------------------------------------

# Raises the rate limit from 3 to 10 requests/second. Free, takes a minute:
# https://account.ncbi.nlm.nih.gov/settings/
#NCBI_API_KEY=

# Sent on every request. NCBI asks for a contact so they can email you before
# blocking you. Recommended for any deployment serving real patients.
#PUBMED_EMAIL=ops@docmode.com

# How PAL identifies itself to NCBI.
#PUBMED_TOOL=PAL

# Oldest publication year retrieved. Default 2000. Enforced twice — as a date
# window on the search, and again on each record that comes back — so a paper
# that slips through the first is dropped by the second. A record with no
# readable publication date is dropped: undatable is not the same as recent.
#PUBMED_MIN_YEAR=2000

# Articles per query. Higher recall, more tokens into the synthesiser.
#PUBMED_MAX_RESULTS=8

# Per-request timeout. A timeout is reported to the patient as "I could not
# check the literature", never as "no evidence exists".
#PUBMED_TIMEOUT_SECONDS=12

# ---------------------------------------------------------------------------
# Drug label route  (services/clinical/drug_route.py)
#
# Looks up a medicine the PATIENT named on PharmEasy/1mg and returns a label
# card with a mandatory disclaimer. Never recommends, compares or substitutes.
#
# To check it against the live sites:
#     docker compose exec api python scripts/verify_pharmacy_live.py
# ---------------------------------------------------------------------------

# false switches the route off entirely; turns are then answered exactly as
# they were before it existed. Default true.
#DRUG_LABEL_LOOKUP_ENABLED=true

# 1mg's search endpoint requires a city and rejects the request without one.
# It affects which listings are shown, never the label content.
#DRUG_LABEL_CITY=Gurgaon

# Whole-route budget. Exceeding it drops the cards, never the answer.
#DRUG_LABEL_TIMEOUT_SECONDS=12
