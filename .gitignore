# --- secret and data hygiene ---------------------------------------------
# These were committed with live values. Untracked here so they stop leaking
# forward; the values already in git history must be ROTATED, and the history
# scrubbed separately (git filter-repo / BFG). Removing them from the index
# does not remove them from history.
.env
.env.*
!.env.example
*.pem
*.key

# Database dumps. backup_family_plan_*.sql carried rows from patients,
# phone_users, health_facts, prescriptions and conversation_turns — patient
# data in a git repository.
*.sql.gz
backup_*.sql
pal_backup.sql
